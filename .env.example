NMS_STORE_ID=
# BLOB_READ_WRITE_TOKEN= is also supported as a fallback.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000/api/auth
ALLIANCE_ADMIN_EMAIL=
# Development only: sign in with local accounts instead of Google (ignored in production and on Vercel).
# LOCAL_AUTH=true
# Email of the editable local admin (default: adminovr@local).
# ADMIN_EMAIL=adminovr@local
# Local account set: leave empty for the development accounts, or use "test" for the 9 fixed test accounts.
# LOCAL_AUTH_SET=test
# Folder of the local data files (default: data).
# NMS_DATA_DIR=data
# Browser pagination sizes (positive integers, fixed at build time).
# NEXT_PUBLIC_LIST_PAGE_SIZE=50
# NEXT_PUBLIC_PLANET_SYSTEMS_PAGE_SIZE=20

# Taxi alerts and user (registration/approval) alerts are implemented. Help and personal-message credentials are reserved for future work.
# Leave a channel's credentials empty until configuring that channel.
# Put real credentials in .env.local or deployment environment variables, never here.
# Per-service switches, reply preferences and Telegram group chat IDs
# are managed in Administration, not through environment variables.
# Channels default to disabled; credentials alone must not enable delivery.
# Separate Discord webhooks for help and taxi (same channel or different channels).
DISCORD_HELP_WEBHOOK_URL=
DISCORD_TAXI_WEBHOOK_URL=
# Separate Telegram bots for help, taxi and private-message alerts.
# Use dedicated test bots locally, not production bots.
TELEGRAM_HELP_BOT_TOKEN=
TELEGRAM_TAXI_BOT_TOKEN=
TELEGRAM_MESSAGES_BOT_TOKEN=
# Telegram bot for registration/approval alerts (Administration → User notifications).
# Can be the same bot as TELEGRAM_TAXI_BOT_TOKEN; the group chat ID is set in Administration.
TELEGRAM_MEMBERS_BOT_TOKEN=
# Resend API key and sender for the account approval email (Administration → User notifications).
# The sender domain must be verified in Resend; leave empty until you configure it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Random secret for the future private-message bot webhook.
# Members link only to the messages bot through /start.
# Local webhook testing requires a public HTTPS tunnel; a bot has only one webhook.
TELEGRAM_MESSAGES_WEBHOOK_SECRET=
# Matching Web Push VAPID key pair; keep the private key secret.
# Generate once with: npx web-push generate-vapid-keys
# Keep keys stable; changing them requires reconnecting browser subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID contact URI, for example mailto:admin@example.com.
VAPID_SUBJECT=
