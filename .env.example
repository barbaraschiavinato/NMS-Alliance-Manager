NMS_STORE_ID=
# BLOB_READ_WRITE_TOKEN= is also supported as a fallback.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000/api/auth
ALLIANCE_ADMIN_EMAIL=
# Development only: sign in with local accounts instead of Google (ignored in production and on Vercel).
# LOCAL_AUTH=true
# Email of the editable local admin (default: adminovr@local).
# ADMIN_EMAIL=adminovr@local
# Local account set: leave empty for the development accounts, or use "test" for the 9 fixed test accounts.
# LOCAL_AUTH_SET=test
# Folder of the local data files (default: data).
# NMS_DATA_DIR=data
# Browser pagination sizes (positive integers, fixed at build time).
# NEXT_PUBLIC_LIST_PAGE_SIZE=50
# NEXT_PUBLIC_PLANET_SYSTEMS_PAGE_SIZE=20
