{
  "name": "alliance-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "LOCAL_AUTH=true next dev --turbopack",
    "dev:test": "rm -rf data-test && cp -R fixtures/test-data data-test && LOCAL_AUTH=true LOCAL_AUTH_SET=test NMS_DATA_DIR=data-test next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
